# MongoDB Atlas connection string (from MongoDB Atlas "Connect" -> "Drivers")
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/nsr_backup?retryWrites=true&w=majority

# Port Render will inject its own PORT, this is just for local dev
PORT=5000

# Comma-separated list of allowed origins for CORS (your Vercel frontend URL)
CORS_ORIGIN=http://localhost:3000
